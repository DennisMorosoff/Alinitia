{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Alinitia: editor write server",
      "type": "shell",
      "command": "node scripts/dev-server.js",
      "isBackground": true,
      "problemMatcher": {
        "owner": "alinitia-dev-server",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Редактор:|уже занят"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
